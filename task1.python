def circular_path(n, m):
    """Возвращает путь (список начальных элементов интервалов) для кругового массива 1..n с шагом m."""
    path = []
    cur = 1  # начинаем с первого элемента
    while True:
        path.append(cur)
        # вычисляем следующий старт
        cur = ((cur - 1 + m) % n) + 1
        if cur == 1:  # вернулись к началу — останавливаемся
            break
    return path

def main():
    # Пример: два массива. Можно заменить на ввод от пользователя.
    n1, m1 = 4, 3   # массив 1: числа 1..4, шаг 3
    n2, m2 = 5, 4   # массив 2: числа 1..5, шаг 4

    path1 = circular_path(n1, m1)
    path2 = circular_path(n2, m2)

    # Объединяем пути в один общий путь
    combined_path = path1 + path2

    print("Путь для первого массива:", path1)
    print("Путь для второго массива:", path2)
    print("Общий объединённый путь:", combined_path)

if __name__ == "__main__":
    main()

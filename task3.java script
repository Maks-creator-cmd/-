const idToValue = {};
for (const item of valuesData) {
  if (item.id !== undefined) idToValue[item.id] = item.value || '';
}

function fillValues(node) {
  if (Array.isArray(node)) return node.map(fillValues);
  if (typeof node === 'object' && node !== null) {
    const result = { ...node };
    if (result.id !== undefined && idToValue.hasOwnProperty(result.id)) {
      result.value = idToValue[result.id];
    }
    if (Array.isArray(result.values)) {
      result.values = fillValues(result.values);
    }
    return result;
  }
  return node;
}

